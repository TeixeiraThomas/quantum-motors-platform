#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Usage: $0 <backup_directory> <restore_root> [--force]"
  echo "Example: $0 /srv/backups/quantum-motors/vm3/20260526-030000 / --force"
  exit 1
fi

backup_dir="$1"
restore_root="$2"
force_flag="${3:-}"

if [ ! -d "$backup_dir" ]; then
  echo "Backup directory not found: $backup_dir"
  exit 1
fi

if [ "$force_flag" != "--force" ]; then
  echo "Restore is destructive. Re-run with --force to continue."
  exit 1
fi

if [ ! -d "$restore_root" ]; then
  mkdir -p "$restore_root"
fi

for archive in "$backup_dir"/*.tar.gz; do
  [ -e "$archive" ] || continue
  tar -xzf "$archive" -C "$restore_root"
done

echo "Restore completed from $backup_dir to $restore_root"
